# TinyNote Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# OpenRouter API Key (REQUIRED)
# Get your API key from: https://openrouter.ai/
# This key is required for AI-powered content generation
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================

# Port for the web server
# Default: 4444
PORT=4444

# ==============================================================================
# PRINTER CONFIGURATION
# ==============================================================================

# Epson TM-T30 Printer IP Address
# Default: 10.1.1.30
# Find your printer's IP by checking your router's DHCP table
PRINTER_IP=10.1.1.30

# Printer Port
# Default: 9100 (standard Epson TM-T30 port)
PRINTER_PORT=9100

# ==============================================================================
# AI MODEL CONFIGURATION
# ==============================================================================

# OpenRouter Model for content generation
# Options: anthropic/claude-3.5-sonnet, anthropic/claude-3-haiku, openai/gpt-4, etc.
# Default: anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Perplexity Model for web search
# Options: perplexity/sonar-small-online, perplexity/sonar-medium-online
# Default: perplexity/sonar-small-online
PERPLEXITY_MODEL=perplexity/sonar-small-online

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================

# Minimum interval between prints (milliseconds)
# Prevents printer overwhelm from rapid requests
# Default: 3000 (3 seconds)
MIN_PRINT_INTERVAL_MS=3000

# Web search timeout (milliseconds)
# Web search models can be slower than generation
# Default: 10000 (10 seconds)
SEARCH_TIMEOUT_MS=10000

# Search cache TTL (milliseconds)
# How long to cache search results to avoid duplicate API calls
# Default: 300000 (5 minutes)
CACHE_TTL_MS=300000

# ==============================================================================
# UNRAID DEPLOYMENT NOTES
# ==============================================================================

# For Unraid deployment via Docker container:
#
# 1. Network Mode:
#    - RECOMMENDED: Host network mode (easiest for printer access)
#    - Alternative: Bridge mode (requires printer IP accessible from container)
#
# 2. Port Mapping (if using bridge mode):
#    - Container Port: 4444
#    - Host Port: 4444 (or any port you prefer)
#
# 3. Volume Mapping:
#    - Container Path: /app/data
#    - Host Path: /mnt/user/appdata/tinynote/data
#    - This persists prompts.json across container updates
#
# 4. Environment Variables:
#    - All variables above can be set in the Unraid Docker template
#    - OPENROUTER_API_KEY is the only REQUIRED variable
#    - All other variables have safe defaults
#
# 5. Finding Your Printer IP:
#    - Check your router's DHCP client list
#    - Look for "Epson", "TM-T30", or similar
#    - Or set a static DHCP reservation for your printer
#
# 6. Testing:
#    - After deployment, access: http://your-unraid-ip:4444
#    - Send a test print via the web interface
#    - Check container logs for any errors
